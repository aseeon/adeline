#!/usr/bin/env bash
# Deletes stale build output from target/ in the main checkout and in every
# worktree under .claude/worktrees/. Keeps target/release (the runnable app)
# and target/dist/Adeline.app (the macOS package).

set -uo pipefail

root=$(dirname "$(git -C "$(dirname "$0")" rev-parse --path-format=absolute --git-common-dir)")

if [[ $OSTYPE == msys* || $OSTYPE == cygwin* ]]; then
  procs=$(powershell.exe -NoProfile -Command \
    'Get-CimInstance Win32_Process | ForEach-Object { "$($_.ExecutablePath) $($_.CommandLine)" }')
else
  procs=$(ps -A -o args=)
  for pid in $(pgrep -x 'cargo|cargo-nextest|rustc'); do
    if [[ -e /proc/$pid/cwd ]]; then
      procs+=$'\n'"cwd: $(readlink "/proc/$pid/cwd")/"
    else
      procs+=$'\n'$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's|^n\(.*\)|cwd: \1/|p')
    fi
  done
fi
uses() {
  awk -v needle="$1" -v except="${2-}" '
    function strip(text, cut,   at) {
      while (cut != "" && (at = index(text, cut))) text = substr(text, 1, at - 1) substr(text, at + length(cut))
      return text
    }
    { line = tolower($0); gsub(/\\/, "/", line) }
    index(strip(line, tolower(except)), tolower(needle)) { found = 1 }
    END { exit !found }' <<<"$procs"
}

busy() {
  local home=$1
  uses "$home/target/" "$home/target/release/" && return 0
  if [[ $home == "$root" ]]; then
    uses "cwd: $home/" "cwd: $root/.claude/worktrees/"
  else
    uses "cwd: $home/"
  fi
}

skipped=0
clean() {
  local home=$1 target=$1/target entry
  [[ -d $target ]] || return 0
  if busy "$home"; then
    echo "clean-build: a build, test or debug Adeline uses $target, skipping it"
    skipped=1
    return 0
  fi
  for entry in "$target"/* "$target"/.[!.]* "$target"/dist/*; do
    case $entry in "$target/release" | "$target/dist" | "$target/dist/Adeline.app") continue ;; esac
    [[ -e $entry ]] || continue
    echo "clean-build: deleting $entry"
    rm -rf "$entry" || echo "clean-build: could not delete $entry"
  done
}

clean "$root"
for worktree in "$root"/.claude/worktrees/*/; do
  [[ -d $worktree ]] && clean "${worktree%/}"
done
exit "$skipped"

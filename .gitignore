# Rust build outputs and profiling results
/target/
/debug/
/artifacts/
*.pdb
**/mutants.out*/

# Packaged releases and archives
/dist/
/dest/
/*.zip
/*.7z
/*.tar
/*.tar.gz

# Throwaway work belongs here; keep maintained scripts/ files in Git
/scratch/
/tmp/
/temp/
/scripts/scratch/
/scripts/tmp/
/scripts/throwaway/

# Tool caches, logs, and backup/conflict copies
__pycache__/
*.py[cod]
*.log
*.tmp
*.bak
*.rs.bk
*.swp
*.swo
*~
*\[conflicted\]*
/.vs/
/.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Local credentials and signing keys
.env
.env.*
!.env.example
!.env.sample
*.pfx
*.p12
*.key

{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "cargo-agents hook claude post-tool-use",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "cargo-agents hook claude pre-tool-use",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "cargo-agents hook claude session-start",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "cargo-agents hook claude stop",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "cargo-agents hook claude user-prompt-submit",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(cargo fmt *)",
      "Bash(cargo build *)",
      "Bash(cargo nextest run *)",
      "Bash(scripts/check-todos)",
      "Bash(bash scripts/check-todos)",
      "Bash(scripts/clippy)",
      "Bash(scripts/clippy *)",
      "Bash(scripts/macos-app)",
      "PowerShell(cargo fmt *)",
      "PowerShell(cargo build *)",
      "PowerShell(cargo nextest run *)",
      "PowerShell(./scripts/clippy.ps1)",
      "PowerShell(./scripts/clippy.ps1 *)",
      "PowerShell(./scripts/package.ps1)",
      "PowerShell(./scripts/package.ps1 *)"
    ]
  }
}